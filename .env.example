# --- App ---
PORT=3000
NODE_ENV=production
APP_NAME="Mini Shop"

# --- Frontend ---
FRONTEND_URL="https://your-frontend-domain.up.railway.app,https://your-custom-domain.com"

# --- Database (SQLite) ---
# Use an absolute path on Railway volume (e.g. /data/db.sqlite)
DB_NAME=/data/db.sqlite

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# --- Mail (Brevo HTTPS API — Railway blocks outbound SMTP on Hobby plans) ---
# Create an API key: https://app.brevo.com/settings/keys/static
BREVO_API_KEY=your_brevo_api_key
# Sender identity (must be a validated sender in Brevo)
SMTP_FROM=your_from_email
SMTP_FROM_NAME=Mini Shop