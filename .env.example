# --- App ---
PORT=3000
NODE_ENV=production
APP_NAME="Mini Shop"

# --- Frontend ---
FRONTEND_URL="https://your-frontend-domain.up.railway.app,https://your-custom-domain.com"

# --- Database (SQLite) ---
# Use an absolute path on Railway volume (e.g. /data/db.sqlite)
DB_NAME=/data/db.sqlite

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# --- SMTP (Brevo) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_key
SMTP_FROM=your_from_email
SMTP_FROM_NAME=Mini Shop